{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@workflow-forge/spec": [
        "./packages/spec/src/index.ts"
      ],
      "@workflow-forge/checks": [
        "./packages/checks/src/index.ts"
      ],
      "@workflow-forge/compiler": [
        "./packages/compiler/src/index.ts"
      ],
      "@workflow-forge/runtime": [
        "./packages/runtime/src/index.ts"
      ],
      "@workflow-forge/packager": [
        "./packages/packager/src/index.ts"
      ],
      "@workflow-forge/author": [
        "./packages/author/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
