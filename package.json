{
  "name": "workflow-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Author, validate, compile, trial-run and package DSH scenario plugins from a restricted WorkflowSpec.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AntonyLang/dsh-workflow-forge.git"
  },
  "keywords": [
    "dsh",
    "plugin",
    "workflow",
    "scenario",
    "structured-output",
    "typescript"
  ],
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "tsx scripts/demo.ts",
    "demo:failure": "tsx scripts/demo-failure.ts",
    "build:scenario": "tsx scripts/build-package.ts",
    "pack:scenario": "npm pack ./packages/scenario-source-brief --pack-destination release"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "ajv": "^8.17.1",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
